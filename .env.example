# ---------------------------------------------------------------------------
# Burki & Company — environment
#
# One variable, and it is optional. The catalogue, the images and the films are
# all part of the project; nothing is fetched from a third-party service, so the
# site builds and runs with no credentials and no network.
# ---------------------------------------------------------------------------

# Public origin. Drives metadataBase, canonical URLs and Open Graph tags.
#
# On Vercel this is OPTIONAL: the site falls back to the project's production
# URL, which Vercel injects itself. Set it once a real domain is pointed at the
# project, so canonical links and share previews use the domain rather than the
# *.vercel.app host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
